# Copy to secrets.yaml (which is gitignored) and fill in.

wifi_ssid: "your-ssid"
wifi_password: "your-wifi-password"

# Password for the fallback setup access point. Minimum 8 characters.
ap_password: "changeme123"

# Generate with: openssl rand -base64 32
api_encryption_key: "REPLACE_WITH_A_BASE64_32_BYTE_KEY"

# Only needed by the "Log in to console" example button.
console_username: "admin"
